{
  "name": "@shelterhub/dsh-mobile-bridge",
  "version": "0.3.0",
  "type": "module",
  "description": "Android/iOS companion bridge for DeepSeek Harness: authenticated LAN and outbound public relay",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "host.mjs",
    "adapter.mjs",
    "protocol.mjs",
    "pairing.mjs",
    "README.md",
    "settings.mjs",
    "client.js",
    "identity.mjs",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "konshinhaoshin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KonshinHaoshin/dsh-app-plugin.git"
  },
  "homepage": "https://github.com/KonshinHaoshin/dsh-app-plugin#readme",
  "bugs": {
    "url": "https://github.com/KonshinHaoshin/dsh-app-plugin/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
